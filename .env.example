# Client-side (safe to embed — these are public SDK keys)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Convex deployment URL (`npx convex dev` writes the dev one; prod comes from `npx convex deploy`).
# Leave unset to run fully local with cloud sync disabled.
EXPO_PUBLIC_CONVEX_URL=https://xxxxxxxx.convex.cloud
EXPO_PUBLIC_RC_IOS_KEY=appl_xxxxxxxx
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxxxxxxx
# RevenueCat Test Store key (dev only — used when no platform key is set; never ship it)
EXPO_PUBLIC_RC_TEST_KEY=test_xxxxxxxx
EXPO_PUBLIC_ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# RevenueCat Web Purchase Link base URL (Dashboard → Funnels → Purchase Links).
# The web funnel appends /<clerkUserId>. Leave unset to hide web checkout.
EXPO_PUBLIC_WEB_PURCHASE_LINK=https://pay.rev.cat/xxxxxxxx
# Layers (layers.com) app id — growth analytics/attribution, native builds only.
# Leave unset to disable the SDK entirely (src/services/analytics.ts no-ops).
EXPO_PUBLIC_LAYERS_APP_ID=xxxxxxxx
# Detour (godetour.dev) deferred deep links: publishable key + app id from the
# dashboard's API configuration, and the app's base link from Link settings.
# Leave unset to skip the SDK; the web landings then link straight to the stores.
EXPO_PUBLIC_DETOUR_API_KEY=xxxxxxxx
EXPO_PUBLIC_DETOUR_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EXPO_PUBLIC_DETOUR_LINK_BASE=https://<org>.godetour.link/<app-hash>

# Server-side only (EAS Hosting env vars — never EXPO_PUBLIC_)
# AERODATABOX_API_KEY=
# RC_WEBHOOK_AUTH=
