{
  "expo": {
    "name": "FlyRight",
    "slug": "flyright",
    "version": "1.0.20",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "flyright",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/ios-icon-dark.png",
        "tinted": "./assets/images/ios-icon-tinted.png"
      },
      "bundleIdentifier": "com.shanavasshaji.flyright",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:getflyright.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSLocationWhenInUseUsageDescription": "FlyRight does not request your location. This notice is required because a bundled notification SDK references location APIs.",
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "PDF document",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          }
        ]
      },
      "buildNumber": "31"
    },
    "android": {
      "package": "com.shanavasshaji.flyright",
      "adaptiveIcon": {
        "backgroundColor": "#0C1B36",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "getflyright.com",
              "pathPrefix": "/t"
            },
            {
              "scheme": "https",
              "host": "getflyright.com",
              "pathPrefix": "/i"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "application/pdf"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 32
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://getflyright.com"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1B36",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-background-task",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "liveActivities": {
            "targetName": "FlyRightWidget",
            "widgetFilePath": "./targets/FlyRightWidget/FlyRightLiveActivity.swift",
            "deploymentTarget": "16.2"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FlyRight reads tickets and boarding passes you upload from your library, and lets you attach photos to the trips in your travel journal.",
          "cameraPermission": "FlyRight scans boarding passes and lets you photograph moments from your trips.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FlyRight scans boarding passes and photographs claim evidence (receipts, PIR forms).",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "@clerk/expo",
        {
          "theme": "./clerk-theme.json"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-mail-composer",
      "expo-sharing",
      "react-native-maps",
      [
        "@layers/expo",
        {
          "ios": {
            "attUsageDescription": "Lets FlyRight see which ads and links bring in new travellers, so we can put effort into what works. Your flights and claims are never shared or sold."
          }
        }
      ],
      "./plugins/with-pods-uuid-fix.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://getflyright.com"
      },
      "eas": {
        "projectId": "37d65a3e-bca7-4915-ab16-8ca73a85f7ac"
      }
    },
    "owner": "shanavascruise"
  }
}
