<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.flyrightliveupdate" >

    <uses-sdk android:minSdkVersion="24" />
    <!--
       Install-time permission gating Android 16 Live Update promotion (status-bar
       chip, lock-screen prominence). Unknown to API <36 installers, so harmless
       to declare unconditionally.
    -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

</manifest>