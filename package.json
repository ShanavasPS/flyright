  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "postinstall": "patch-package",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "sync-versions": "node ./scripts/sync-build-numbers.mjs",
    "build-airport-timezones": "node ./scripts/build-airport-timezones.mjs",
    "test:security": "node scripts/security-regressions.cjs",
    "release:backend": "node scripts/check-backend-contract.mjs --prod",
    "release:deploy-backend": "convex deploy -y && convex dev --once && npm run release:backend && node scripts/check-backend-contract.mjs --dev",
    "release:preflight": "npm run typecheck && node --test scripts/check-backend-contract.test.mjs && jest --runInBand --watchman=false && npm run release:backend",
    "release:devices": "node scripts/release-device-check.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@swmansion/react-native-detour))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/scripts/jest-css-stub.js"
    }
  },
  "private": true,
  "overrides": {
    "decode-uri-component": "$decode-uri-component"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  }
}
